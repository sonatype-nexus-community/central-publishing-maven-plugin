import java.io.*;
import java.util.*;

source("src/it/shared/metadata.bsh");

System.out.println("Validating staging directory existence");
File stagingDirectory = new File( "target/it/bundle-bom-snapshot-module-it/target/central-staging" );
if (!stagingDirectory.exists()) {
  throw new FileNotFoundException("Staging directory not created: " + stagingDirectory.getAbsolutePath());
}

System.out.println("Validating deferred directory existence");
File deferredDirectory = new File( "target/it/bundle-bom-snapshot-module-it/target/central-deferred" );
if (!deferredDirectory.exists()) {
  throw new FileNotFoundException("Deferred directory not created: " + deferredDirectory.getAbsolutePath());
}

System.out.println("Staging and Deferred directories in place, validating content");

String[] stagingFilePaths = {
  "org/sonatype/central/child1/1.0.0/child1-1.0.0.jar",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0.jar.md5",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0.jar.sha1",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0.jar.sha256",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0.jar.sha512",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0.pom",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0.pom.md5",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0.pom.sha1",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0.pom.sha256",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0.pom.sha512",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0-javadoc.jar",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0-javadoc.jar.md5",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0-javadoc.jar.sha1",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0-javadoc.jar.sha256",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0-javadoc.jar.sha512",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0-sources.jar",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0-sources.jar.md5",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0-sources.jar.sha1",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0-sources.jar.sha256",
  "org/sonatype/central/child1/1.0.0/child1-1.0.0-sources.jar.sha512",
};

checkPresent(stagingDirectory, stagingFilePaths);

String[] deferredFilePaths = {
  ".index",
  "org/sonatype/central/bundle-bom-parent-snapshot-module-it/1.0.0-SNAPSHOT/bundle-bom-parent-snapshot-module-it-1.0.0-SNAPSHOT.pom",
  "org/sonatype/central/bundle-bom-parent-snapshot-module-it/1.0.0-SNAPSHOT/maven-metadata-central-staging.xml",
  "org/sonatype/central/bundle-bom-parent-snapshot-module-it/maven-metadata-central-staging.xml",
  "org/sonatype/central/bundle-bom-snapshot-module-it/1.0.0-SNAPSHOT/bundle-bom-snapshot-module-it-1.0.0-SNAPSHOT.pom",
  "org/sonatype/central/bundle-bom-snapshot-module-it/1.0.0-SNAPSHOT/maven-metadata-central-staging.xml",
  "org/sonatype/central/bundle-bom-snapshot-module-it/maven-metadata-central-staging.xml",
  "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT.jar",
  "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT.jar.md5",
  "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT.jar.sha1",
  "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT.pom",
  "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT-javadoc.jar",
  "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT-javadoc.jar.md5",
  "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT-javadoc.jar.sha1",
  "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT-sources.jar",
  "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT-sources.jar.md5",
  "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT-sources.jar.sha1",
  "org/sonatype/central/child2/1.0.0-SNAPSHOT/maven-metadata-central-staging.xml",
  "org/sonatype/central/child2/maven-metadata-central-staging.xml",
};

checkPresent(deferredDirectory, deferredFilePaths);

String[] excludedStagingFilePaths = {
  "org/sonatype/central/bundle-bom-parent-release-and-snapshot-module-it",
  "org/sonatype/central/bundle-bom-snapshot-module-it",
  "org/sonatype/central/child1/maven-metadata-central-staging.xml",
  "org/sonatype/central/child1/1.0.0/maven-metadata-central-staging.xml",
  "org/sonatype/central/child2",
};

checkAbsent(stagingDirectory, excludedStagingFilePaths, true);

String[] excludedDeferredFilePaths = {
  "org/sonatype/central/child1",
};

checkAbsent(deferredDirectory, excludedDeferredFilePaths, true);

File bundleDirectory = new File( "target/it/bundle-bom-snapshot-module-it/target/central-publishing" );
if (!bundleDirectory.exists()) {
  throw new FileNotFoundException("Bundle directory not created: " + bundleDirectory.getAbsolutePath());
}
System.out.println("Bundle directory in place, validating content");

File file = new File(bundleDirectory, "central-bundle.zip");
System.out.println( "Checking for existence of " + file );
if (!file.isFile()) {
  throw new FileNotFoundException( "Missing bundle file: " + file.getAbsolutePath() );
}

return true;
