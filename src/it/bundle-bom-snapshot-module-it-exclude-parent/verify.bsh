import java.io.*;
import java.util.*;
import java.io.File;
import java.io.FileNotFoundException;
import java.nio.file.Files;

File projectDirectory = new File("target/it/bundle-bom-snapshot-module-it-exclude-parent");

System.out.println("Validating deferred directory existence");
File deferredDirectory = new File( "target/it/bundle-bom-snapshot-module-it-exclude-parent/target/central-deferred" );
if (!deferredDirectory.exists()) {
  throw new FileNotFoundException("Staging directory not created: " + deferredDirectory.getAbsolutePath());
}
System.out.println("Staging directory in place, validating content");

String[] deferredFilePaths = {
    "org/sonatype/central/bundle-bom-parent-snapshot-module-it/maven-metadata-central-staging.xml",
    "org/sonatype/central/bundle-bom-parent-snapshot-module-it/1.0.0-SNAPSHOT/maven-metadata-central-staging.xml",
    "org/sonatype/central/bundle-bom-parent-snapshot-module-it/1.0.0-SNAPSHOT/bundle-bom-parent-snapshot-module-it-1.0.0-SNAPSHOT.pom",
    "org/sonatype/central/child1/maven-metadata-central-staging.xml",
    "org/sonatype/central/child1/1.0.0-SNAPSHOT/maven-metadata-central-staging.xml",
    "org/sonatype/central/child1/1.0.0-SNAPSHOT/child1-1.0.0-SNAPSHOT.pom",
    "org/sonatype/central/child1/1.0.0-SNAPSHOT/child1-1.0.0-SNAPSHOT.jar",
    "org/sonatype/central/child1/1.0.0-SNAPSHOT/child1-1.0.0-SNAPSHOT.jar.md5",
    "org/sonatype/central/child1/1.0.0-SNAPSHOT/child1-1.0.0-SNAPSHOT.jar.sha1",
    "org/sonatype/central/child1/1.0.0-SNAPSHOT/child1-1.0.0-SNAPSHOT-javadoc.jar",
    "org/sonatype/central/child1/1.0.0-SNAPSHOT/child1-1.0.0-SNAPSHOT-javadoc.jar.md5",
    "org/sonatype/central/child1/1.0.0-SNAPSHOT/child1-1.0.0-SNAPSHOT-javadoc.jar.sha1",
    "org/sonatype/central/child1/1.0.0-SNAPSHOT/child1-1.0.0-SNAPSHOT-sources.jar",
    "org/sonatype/central/child1/1.0.0-SNAPSHOT/child1-1.0.0-SNAPSHOT-sources.jar.md5",
    "org/sonatype/central/child1/1.0.0-SNAPSHOT/child1-1.0.0-SNAPSHOT-sources.jar.sha1",
    "org/sonatype/central/child2/maven-metadata-central-staging.xml",
    "org/sonatype/central/child2/1.0.0-SNAPSHOT/maven-metadata-central-staging.xml",
    "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT.pom",
    "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT.jar",
    "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT.jar.md5",
    "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT.jar.sha1",
    "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT-javadoc.jar",
    "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT-javadoc.jar.md5",
    "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT-javadoc.jar.sha1",
    "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT-sources.jar",
    "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT-sources.jar.md5",
    "org/sonatype/central/child2/1.0.0-SNAPSHOT/child2-1.0.0-SNAPSHOT-sources.jar.sha1",
};

for (String deferredFilePath : deferredFilePaths) {
  File file = new File(deferredDirectory, deferredFilePath);
  System.out.println( "Checking for existence of " + file );
  if (!file.isFile()) {
    throw new FileNotFoundException( "Missing deferred file: " + file.getAbsolutePath() );
  }
}

String[] excludedStagingFilePaths = {
    "org/sonatype/central/bundle-bom-snapshot-module-it-exclude-parent/maven-metadata-central-staging.xml",
    "org/sonatype/central/bundle-bom-snapshot-module-it-exclude-parent/1.0.0-SNAPSHOT/maven-metadata-central-staging.xml",
    "org/sonatype/central/bundle-bom-snapshot-module-it-exclude-parent/1.0.0-SNAPSHOT/bundle-bom-snapshot-module-it-exclude-parent-1.0.0-SNAPSHOT.pom",
};

for (String deferredFilePath : excludedStagingFilePaths) {
  File file = new File(deferredDirectory, deferredFilePath);
  System.out.println( "Checking for existence of " + file );
  if (file.isFile()) {
    throw new Exception( "Did not excluded deferred file: " + file.getAbsolutePath() );
  }
}

File buildLog = new File(projectDirectory, "build.log");
String logOutput = new String(Files.readAllBytes(buildLog.toPath()));
String matchString = "[INFO] Uploading to mockcentral-irrelevant: ";
System.out.println( "Checking for upload response in build log " + buildLog.getAbsolutePath() );
if (!logOutput.contains(matchString)) {
  throw new RuntimeException("The logfile output in " + buildLog.getAbsolutePath() +
      " does not contain \"" + matchString + "\"");
}

matchString = "[INFO] BUILD SUCCESS";
if (!logOutput.contains(matchString)) {
  throw new RuntimeException("The logfile output in " + buildLog.getAbsolutePath() +
      " does not contain \"" + matchString + "\"");
}

return true;
