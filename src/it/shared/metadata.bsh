import java.io.File;
import java.io.FileNotFoundException;

// Shared by the verify.bsh scripts of the integration tests, which load it with
//   source("src/it/shared/metadata.bsh");
//
// The repository metadata that Maven writes into the plugin's staging and deferred directories is called
// maven-metadata-central-staging.xml by Maven 3.9 and earlier, and maven-metadata-local.xml by Maven 3.10, which
// treats those directories as local repositories. The integration tests run on both, and do not care which Maven wrote
// the metadata, so they ask these functions instead of naming a file.

String[] METADATA_FILE_NAMES = { "maven-metadata-central-staging.xml", "maven-metadata-local.xml" };

// Turns ".../maven-metadata-central-staging.xml" into the directory it is in, or returns null for any other path.
String metadataDirectoryOf(String path) {
  for (String name : METADATA_FILE_NAMES) {
    if (path.endsWith("/" + name)) {
      return path.substring(0, path.length() - name.length());
    }
  }
  return null;
}

// True if the directory holds repository metadata, whichever Maven wrote it.
boolean metadataExists(File directory) {
  for (String name : METADATA_FILE_NAMES) {
    if (new File(directory, name).isFile()) {
      return true;
    }
  }
  return false;
}

// Checks that every listed file exists below the root. A metadata file, under either of its names, is satisfied by
// whichever one this Maven wrote. Anything else must exist as named.
void checkPresent(File root, String[] paths) {
  for (String path : paths) {
    String metadataDirectory = metadataDirectoryOf(path);
    if (metadataDirectory != null) {
      File directory = new File(root, metadataDirectory);
      System.out.println("Checking for repository metadata in " + directory);
      if (!metadataExists(directory)) {
        throw new FileNotFoundException("Missing repository metadata (" + METADATA_FILE_NAMES[0] + " or " +
            METADATA_FILE_NAMES[1] + ") in " + directory.getAbsolutePath());
      }
    }
    else {
      File file = new File(root, path);
      System.out.println("Checking for existence of " + file);
      if (!file.isFile()) {
        throw new FileNotFoundException("Missing file: " + file.getAbsolutePath());
      }
    }
  }
}

// Checks that none of the listed files exist below the root. A metadata file must be absent under both of its names,
// so that the check still means something on a Maven that never writes the name that is listed.
void checkAbsent(File root, String[] paths) {
  checkAbsent(root, paths, false);
}

// As above. With alsoDirectories, a directory at one of the paths counts as present too, which is what the tests need
// when a path names a directory that must not have been created.
void checkAbsent(File root, String[] paths, boolean alsoDirectories) {
  for (String path : paths) {
    String metadataDirectory = metadataDirectoryOf(path);
    if (metadataDirectory != null) {
      File directory = new File(root, metadataDirectory);
      System.out.println("Checking for no repository metadata in " + directory);
      if (metadataExists(directory)) {
        throw new Exception("Did not exclude repository metadata in " + directory.getAbsolutePath());
      }
    }
    else {
      File file = new File(root, path);
      System.out.println("Checking for no " + file);
      if (file.isFile() || (alsoDirectories && file.isDirectory())) {
        throw new Exception("Did not exclude file: " + file.getAbsolutePath());
      }
    }
  }
}
