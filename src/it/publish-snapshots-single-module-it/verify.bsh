import java.io.File;
import java.io.FileNotFoundException;
import java.nio.file.Files;

File projectDirectory = new File("target/it/publish-snapshots-single-module-it");
File targetDirectory = new File(projectDirectory, "target");
System.out.println("Validating deferred directory existence");
File deferredDirectory = new File(targetDirectory, "central-deferred");
if (!deferredDirectory.exists()) {
  throw new FileNotFoundException("Deferred directory not created: " + deferredDirectory.getAbsolutePath());
}
System.out.println("Deferred directory in place, validating content");

String[] stagedFilePaths = {
    "org/sonatype/central/publish-snapshots-single-module-it/maven-metadata-central-staging.xml",
    "org/sonatype/central/publish-snapshots-single-module-it/1.0.0-SNAPSHOT/publish-snapshots-single-module-it-1.0.0-SNAPSHOT.pom",
    "org/sonatype/central/publish-snapshots-single-module-it/1.0.0-SNAPSHOT/publish-snapshots-single-module-it-1.0.0-SNAPSHOT.jar"
};

for (String stagedFilePath : stagedFilePaths) {
  File stagedFile = new File(deferredDirectory, stagedFilePath);
  System.out.println( "Checking for existence of " + stagedFile );
  if (!stagedFile.isFile()) {
    throw new FileNotFoundException( "Missing staged file: " + stagedFile.getAbsolutePath() );
  }
}

String[] excludedStagingFilePaths = {

};

for (String deferredFilePath : excludedStagingFilePaths) {
  File file = new File(deferredDirectory, deferredFilePath);
  System.out.println( "Checking for existence of " + file );
  if (file.isFile()) {
    throw new Exception( "Did not excluded deferred file: " + file.getAbsolutePath() );
  }
}

File buildLog = new File(projectDirectory, "build.log");
String logOutput = new String(Files.readAllBytes(buildLog.toPath()));
String matchString = "[INFO] Uploading to mockcentral: ";
System.out.println( "Checking for upload response in build log " + buildLog.getAbsolutePath() );
if (!logOutput.contains(matchString)) {
  throw new RuntimeException("The logfile output in " + buildLog.getAbsolutePath() +
      " does not contain \"" + matchString + "\"");
}

matchString = "[INFO] BUILD SUCCESS";
if (!logOutput.contains(matchString)) {
  throw new RuntimeException("The logfile output in " + buildLog.getAbsolutePath() +
      " does not contain \"" + matchString + "\"");
}

return true;
