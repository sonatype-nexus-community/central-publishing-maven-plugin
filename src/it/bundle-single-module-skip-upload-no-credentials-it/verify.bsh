import java.io.File;
import java.io.FileNotFoundException;
import java.nio.file.Files;
import java.util.*;
import java.util.zip.ZipEntry;
import java.util.zip.ZipFile;

// skipUpload must build a real bundle and stop before uploading it, without ever looking up Central credentials. The
// server id in the pom is not defined in settings.xml, so the build itself fails if credentials are looked up.

File projectDirectory = new File("target/it/bundle-single-module-skip-upload-no-credentials-it");

File bundle = new File(projectDirectory, "target/central-publishing/central-bundle.zip");
System.out.println("Checking for existence of " + bundle);
if (!bundle.isFile()) {
  throw new FileNotFoundException("Missing bundle file: " + bundle.getAbsolutePath());
}

// The bundle must be a real archive holding the component, not just a file that exists.
String gav = "org/sonatype/central/bundle-single-module-skip-upload-no-credentials-it/1.0/" +
    "bundle-single-module-skip-upload-no-credentials-it-1.0";
Set entries = new HashSet();
ZipFile zip = new ZipFile(bundle);
try {
  Enumeration all = zip.entries();
  while (all.hasMoreElements()) {
    entries.add(((ZipEntry) all.nextElement()).getName());
  }
}
finally {
  zip.close();
}
System.out.println("Bundle entries: " + entries);

String[] required = { gav + ".pom", gav + ".jar", gav + ".pom.md5", gav + ".jar.sha1" };
for (String path : required) {
  if (!entries.contains(path)) {
    throw new Exception("The bundle does not contain " + path + ". It holds: " + entries);
  }
}

// The build log must show that the upload was skipped on purpose, and that nothing was sent to Central.
File buildLog = new File(projectDirectory, "build.log");
String log = new String(Files.readAllBytes(buildLog.toPath()), "UTF-8");

String skipped = "Skipping the upload of the bundle at user's request (skipUpload)";
if (!log.contains(skipped)) {
  throw new Exception("The build log does not say the upload was skipped: expected '" + skipped + "'");
}
String[] mustNotAppear = { "Going to upload", "Unable to upload", "Using credentials from server id",
    "Unable to get publisher server properties" };
for (String text : mustNotAppear) {
  if (log.contains(text)) {
    throw new Exception("The build log contains '" + text + "', so the plugin tried to reach Central");
  }
}
if (!log.contains("BUILD SUCCESS")) {
  throw new Exception("The build did not succeed");
}

return true;
