import java.io.*;
import java.util.*;

System.out.println("Validating staging directory existence");

File stagingDirectory = new File( "target/it/publish-bom-module-it-ignore-published/target/central-staging" );
if (!stagingDirectory.exists()) {
  throw new FileNotFoundException("Staging directory not created: " + stagingDirectory.getAbsolutePath());
}
System.out.println("Staging directory in place, validating content");

String[] stagingFilePaths = {
    "org/sonatype/central/child11/1.0.0/child11-1.0.0.pom",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0.pom.md5",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0.pom.sha1",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0.pom.sha256",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0.pom.sha512",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0.jar",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0.jar.md5",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0.jar.sha1",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0.jar.sha256",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0.jar.sha512",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0-javadoc.jar",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0-javadoc.jar.md5",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0-javadoc.jar.sha1",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0-javadoc.jar.sha256",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0-javadoc.jar.sha512",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0-sources.jar",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0-sources.jar.md5",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0-sources.jar.sha1",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0-sources.jar.sha256",
    "org/sonatype/central/child11/1.0.0/child11-1.0.0-sources.jar.sha512",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0.pom",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0.pom.md5",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0.pom.sha1",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0.pom.sha256",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0.pom.sha512",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0.jar",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0.jar.md5",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0.jar.sha1",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0.jar.sha256",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0.jar.sha512",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0-javadoc.jar",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0-javadoc.jar.md5",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0-javadoc.jar.sha1",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0-javadoc.jar.sha256",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0-javadoc.jar.sha512",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0-sources.jar",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0-sources.jar.md5",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0-sources.jar.sha1",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0-sources.jar.sha256",
    "org/sonatype/central/child22/1.0.0/child22-1.0.0-sources.jar.sha512",
};

for (String stagingFilePath : stagingFilePaths) {
  File file = new File(stagingDirectory, stagingFilePath);
  System.out.println( "Checking for existence of " + file );
  if (!file.isFile()) {
    throw new FileNotFoundException( "Missing staging file: " + file.getAbsolutePath() );
  }
}

String[] excludedStagingFilePaths = {
  "org/sonatype/central/bundle-bom-module-it-ignore-published/maven-metadata-central-staging.xml",
  "org/sonatype/central/bundle-bom-module-it-ignore-published/1.0.0/maven-metadata-central-staging.xml",
  "org/sonatype/central/bundle-bom-parent-module-it-published/maven-metadata-central-staging.xml",
  "org/sonatype/central/bundle-bom-parent-module-it-published/1.0.0/maven-metadata-central-staging.xml",
  "org/sonatype/central/child11/maven-metadata-central-staging.xml",
  "org/sonatype/central/child22/maven-metadata-central-staging.xml",
  "org/sonatype/central/child11/1.0.0/maven-metadata-central-staging.xml",
  "org/sonatype/central/child22/1.0.0/maven-metadata-central-staging.xml",
  "org/sonatype/central/bundle-bom-parent-module-it-published/1.0.0/bundle-bom-parent-module-it-published-1.0.0.pom",
  "org/sonatype/central/bundle-bom-parent-module-it-published/bundle-bom-parent-module-it-published.pom",
  "org/sonatype/central/bundle-bom-parent-module-it-published/1.0.0/bundle-bom-parent-module-it-published-1.0.0.pom",
  "org/sonatype/central/bundle-bom-parent-module-it-published/1.0.0/bundle-bom-parent-module-it-published-1.0.0.pom.md5",
  "org/sonatype/central/bundle-bom-parent-module-it-published/1.0.0/bundle-bom-parent-module-it-published-1.0.0.pom.sha1",
  "org/sonatype/central/bundle-bom-parent-module-it-published/1.0.0/bundle-bom-parent-module-it-published-1.0.0.pom.sha256",
  "org/sonatype/central/bundle-bom-parent-module-it-published/1.0.0/bundle-bom-parent-module-it-published-1.0.0.pom.sha512",
};

for (String stagingFilePath : excludedStagingFilePaths) {
  File file = new File(stagingDirectory, stagingFilePath);
  System.out.println( "Checking for existence of " + file );
  if (file.isFile()) {
    throw new Exception( "Did not excluded staging file: " + file.getAbsolutePath() );
  }
}

File bundleDirectory = new File( "target/it/publish-bom-module-it-ignore-published/target/central-publishing" );
if (!bundleDirectory.exists()) {
  throw new FileNotFoundException("Bundle directory not created: " + bundleDirectory.getAbsolutePath());
}
System.out.println("Bundle directory in place, validating content");

File file = new File(bundleDirectory, "central-bundle.zip");
System.out.println( "Checking for existence of " + file );
if (!file.isFile()) {
  throw new FileNotFoundException( "Missing bundle file: " + file.getAbsolutePath() );
}

return true;
