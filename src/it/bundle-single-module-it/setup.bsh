import java.io.*;
import java.util.*;

import org.apache.maven.shared.utils.io.FileUtils;

File stagingDirectory = new File( "target/it/bundle-single-module-it/target/central-staging" );

// set up an example file left behind from a previous build
FileUtils.forceMkdir(stagingDirectory);
File oldJar = new File(stagingDirectory.getAbsolutePath() + "/org/sonatype/central/bundle-single-module-it/0.1/bundle-single-module-it-0.1.jar");
FileUtils.forceMkdir(oldJar.getParentFile());
oldJar.createNewFile();

File publishingDirectory = new File("target/it/bundle-single-module-it/target/central-publishing");

// set up an example file left behind from a previous build
FileUtils.forceMkdir(publishingDirectory);
File oldBundle = new File(publishingDirectory.getAbsolutePath() + "/central-bundle.zip");
FileUtils.forceMkdir(oldBundle.getParentFile());
oldBundle.createNewFile();

return true;
