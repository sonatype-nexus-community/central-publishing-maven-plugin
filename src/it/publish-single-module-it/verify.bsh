import java.io.File;
import java.io.FileNotFoundException;
import java.nio.file.Files;

File projectDirectory = new File("target/it/publish-single-module-it");
File targetDirectory = new File(projectDirectory, "target");
System.out.println("Validating staging directory existence");
File stagingDirectory = new File(targetDirectory, "central-staging");
if (!stagingDirectory.exists()) {
  throw new FileNotFoundException("Staging directory not created: " + stagingDirectory.getAbsolutePath());
}
System.out.println("Staging directory in place, validating content");

String[] stagedFilePaths = {
    "org/sonatype/central/publish-single-module-it/1.0/publish-single-module-it-1.0.pom",
    "org/sonatype/central/publish-single-module-it/1.0/publish-single-module-it-1.0.pom.md5",
    "org/sonatype/central/publish-single-module-it/1.0/publish-single-module-it-1.0.pom.sha1",
    "org/sonatype/central/publish-single-module-it/1.0/publish-single-module-it-1.0.pom.sha256",
    "org/sonatype/central/publish-single-module-it/1.0/publish-single-module-it-1.0.pom.sha512",
    "org/sonatype/central/publish-single-module-it/1.0/publish-single-module-it-1.0.jar",
    "org/sonatype/central/publish-single-module-it/1.0/publish-single-module-it-1.0.jar.md5",
    "org/sonatype/central/publish-single-module-it/1.0/publish-single-module-it-1.0.jar.sha1",
    "org/sonatype/central/publish-single-module-it/1.0/publish-single-module-it-1.0.jar.sha256",
    "org/sonatype/central/publish-single-module-it/1.0/publish-single-module-it-1.0.jar.sha512",
};

for (String stagedFilePath : stagedFilePaths) {
  File stagedFile = new File(stagingDirectory, stagedFilePath);
  System.out.println( "Checking for existence of " + stagedFile );
  if (!stagedFile.isFile()) {
    throw new FileNotFoundException( "Missing staged file: " + stagedFile.getAbsolutePath() );
  }
}

String[] excludedStagingFilePaths = {
    "org/sonatype/central/publish-single-module-it/maven-metadata-central-staging.xml",
    "org/sonatype/central/publish-single-module-it/1.0/maven-metadata-central-staging.xml.md5",
    "org/sonatype/central/publish-single-module-it/1.0/maven-metadata-central-staging.xml.sha1",
    "org/sonatype/central/publish-single-module-it/1.0/maven-metadata-central-staging.xml.sha256",
    "org/sonatype/central/publish-single-module-it/1.0/maven-metadata-central-staging.xml.sha512",
    "org/sonatype/central/publish-single-module-it/1.0/maven-metadata-central-staging.xml",
};

for (String stagingFilePath : excludedStagingFilePaths) {
  File file = new File(stagingDirectory, stagingFilePath);
  System.out.println( "Checking for existence of " + file );
  if (file.isFile()) {
    throw new Exception( "Did not excluded staging file: " + file.getAbsolutePath() );
  }
}

File bundleDirectory = new File( targetDirectory, "central-publishing" );
if (!bundleDirectory.exists()) {
  throw new FileNotFoundException("Bundle directory not created: " + bundleDirectory.getAbsolutePath());
}
System.out.println("Bundle directory in place, validating content");

File bundle = new File(bundleDirectory, "central-bundle.zip");
System.out.println( "Checking for existence of " + bundle );
if (!bundle.isFile()) {
  throw new FileNotFoundException( "Missing bundle file: " + bundle.getAbsolutePath() );
}

File buildLog = new File(projectDirectory, "build.log");
String logOutput = new String(Files.readAllBytes(buildLog.toPath()));
String matchString = "Uploaded bundle successfully, deployment name: Deployment, deploymentId: a_deployment_id";
System.out.println( "Checking for upload response in build log " + buildLog.getAbsolutePath() );
if (!logOutput.contains(matchString)) {
  throw new RuntimeException("The logfile output in " + buildLog.getAbsolutePath() +
      " does not contain \"" + matchString + "\"");
}

return true;
