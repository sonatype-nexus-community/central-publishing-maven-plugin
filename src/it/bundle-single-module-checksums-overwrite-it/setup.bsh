import java.io.File;
import java.io.FileNotFoundException;

import org.apache.maven.shared.utils.io.FileUtils;

File stagingDirectory = new File( "target/central-staging" );
if (stagingDirectory.exists()) {
  FileUtils.deleteDirectory(stagingDirectory);
}

//now lets populate the directory with some junk checksums
String[] checksumFilePaths = {
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0.pom.md5",
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0.pom.sha1",
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0.pom.sha256",
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0.pom.sha512",
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0.jar.md5",
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0.jar.sha1",
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0.jar.sha256",
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0.jar.sha512",
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0-javadoc.jar.md5",
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0-javadoc.jar.sha1",
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0-javadoc.jar.sha256",
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0-javadoc.jar.sha512",
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0-sources.jar.md5",
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0-sources.jar.sha1",
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0-sources.jar.sha256",
  "org/sonatype/central/bundle-single-module-checksums-overwrite-it/1.0/bundle-single-module-checksums-overwrite-it-1.0-sources.jar.sha512"
};

for (String checksumFilePath : checksumFilePaths) {
  File file = new File(stagingDirectory, checksumFilePath);
  System.out.println( "Creating invalid checksum at " + file );
  file.getParentFile().mkdirs();
  FileUtils.fileWrite(file, "UTF-8", "invalid_checksum");
  if (!file.isFile()) {
    throw new FileNotFoundException( "Failed to create checksum file: " + file.getAbsolutePath() );
  }
}

return true;
